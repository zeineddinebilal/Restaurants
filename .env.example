# ==============================================================================
# Application Branding (Single Source of Truth — see src/config/brand.ts)
# ==============================================================================
NEXT_PUBLIC_APP_NAME="PlateFit"
NEXT_PUBLIC_APP_NAME_AR="بليت فيت"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# Database (PostgreSQL)
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/platefit?schema=public"

# ==============================================================================
# Authentication (Auth.js / NextAuth v5)
# Generate with: openssl rand -base64 32
# ==============================================================================
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
AUTH_TRUST_HOST="true"

# Optional Google OAuth (leave blank to disable Google button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ==============================================================================
# Gemini AI (@google/genai)
# Leave GEMINI_API_KEY empty to test graceful "AI not configured" degradation
# ==============================================================================
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# ==============================================================================
# Demo & Seed Configuration
# DEMO_MODE enables the Demo Persona Switcher ONLY on the demo restaurant
# SEED_DEMO=true enables seeding demo users & "Demo Lebanese Kitchen"
# ==============================================================================
DEMO_MODE="true"
SEED_DEMO="true"
DEMO_PASSWORD="change-me-local-demo-password"

# ==============================================================================
# Optional S3-Compatible Dish Photo Storage (AWS S3, Cloudflare R2, etc.)
# In development (NODE_ENV=development), missing S3 vars fall back to public/uploads.
# In production (NODE_ENV=production), missing S3 vars cleanly disable photo upload.
# ==============================================================================
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ==============================================================================
# Table Session & Anti-Spam Defaults
# ==============================================================================
TABLE_SESSION_TTL_HOURS="4"
