{
  "name": "platefit",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"prisma/**/*.ts\" && prisma format",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"prisma/**/*.ts\"",
    "test": "tsx --test \"src/**/__tests__/**/*.test.ts\"",
    "test:watch": "tsx --test --watch \"src/**/__tests__/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@google/genai": "^3.3.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.511.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.26.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.5.3",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
